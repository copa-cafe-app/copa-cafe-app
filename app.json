{
  "expo": {
    "name": "Copa Café",
    "slug": "copa-cafe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7FAF5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.copacafe.app"
    },
    "android": {
      "package": "com.copacafe.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#008542"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "copa-cafe",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-camera",
      "expo-location"
    ],
    "extra": {
      "eas": {
        "projectId": "6ff4817d-0ca8-4317-be09-229b40128432"
      },
      "router": {}
    },
    "owner": "copacafe"
  }
}
